{
  "name": "new-commerce-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate": "openapi-typescript contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "generated-diff": "git diff --exit-code -- src/lib/api/schema.d.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run generate && npm run generated-diff && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@remixicon/react": "^4.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.473.0",
    "next": "15.1.9",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.9",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.9",
    "jsdom": "^28.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.4",
      "@types/react-dom": "19.0.2"
    }
  }
